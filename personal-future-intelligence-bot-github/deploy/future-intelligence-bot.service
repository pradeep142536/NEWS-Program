[Unit]
Description=Personal Future Intelligence Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/personal-future-intelligence-bot
EnvironmentFile=/etc/future-bot.env
ExecStart=/usr/bin/python3 /opt/personal-future-intelligence-bot/bot.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/future-bot

[Install]
WantedBy=multi-user.target
